# Build artifacts not submitted:
*.elf
*.o
*.a
*.d

# VU microprogram intermediates:
*.pp.vcl
*.vsm

# Everything under build/ is generated - the per-config object trees and ELFs,
# the host tool binaries, the bin2c IRX intermediates. dummy.txt is only there
# to keep the directory in the repo.
build/*
!build/dummy.txt

# Quake game data (id1/pak0.pak, config.cfg, saves), not part of this repository.
id1/*

# Release packages:
github_rel_*/

# Generated per-machine editor tooling:
compile_commands.json

# MacOS stuff:
.DS_Store

# Clangd source code parsing caches.
.cache
